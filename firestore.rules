rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == "google.com";
    }
    function acceptedRules() {
      return signedIn() && get(/databases/$(database)/documents/agreements/$(request.auth.uid)).data.version == '2026-10-05';
    }
    match /agreements/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'acceptedAt'])
        && request.resource.data.version == '2026-10-05'
        && request.resource.data.acceptedAt == request.time;
    }
    function owner() {
      return signedIn() && request.auth.token.get('owner', false) == true;
    }
    function staff() {
      return owner() || (signedIn() &&
        (exists(/databases/$(database)/documents/team/$(request.auth.uid))
          ? get(/databases/$(database)/documents/team/$(request.auth.uid)).data.role == 'moderator'
            && get(/databases/$(database)/documents/team/$(request.auth.uid)).data.active == true
          : request.auth.token.get('admin', false) == true));
    }
    function activePlayer(uid) {
      return !exists(/databases/$(database)/documents/players/$(uid))
        || get(/databases/$(database)/documents/players/$(uid)).data.get('removed', false) == false;
    }
    match /team/{uid} {
      allow get: if owner() || (signedIn() && request.auth.uid == uid);
      allow list: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['role', 'active', 'displayName', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['role', 'active', 'displayName', 'updatedBy', 'updatedAt'])
        && request.resource.data.role == 'moderator'
        && request.resource.data.active is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3 && request.resource.data.displayName.size() <= 60
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.active ||
          (exists(/databases/$(database)/documents/players/$(uid)) && activePlayer(uid)
            && request.resource.data.displayName == get(/databases/$(database)/documents/players/$(uid)).data.displayName));
      // Keep revocations so an old admin claim cannot silently restore access.
      allow delete: if false;
    }
    function httpsLink(value) {
      return value is string && value.size() <= 2000 && value.matches('^https://.+');
    }
    function validLevel(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.position is int && data.position > 0
        && data.points is number && data.points >= 0
        && data.creator is string && data.creator.size() > 0 && data.creator.size() <= 60
        && data.verifier is string && data.verifier.size() > 0 && data.verifier.size() <= 60
        && httpsLink(data.levelUrl) && httpsLink(data.proofUrl);
    }
    function validCountry(code) {
      return code is string && code in [
          'AD', 'AE', 'AF', 'AG', 'AI', 'AL', 'AM', 'AO', 'AQ', 'AR', 'AS', 'AT', 'AU', 'AW', 'AX',
          'AZ', 'BA', 'BB', 'BD', 'BE', 'BF', 'BG', 'BH', 'BI', 'BJ', 'BL', 'BM', 'BN', 'BO', 'BQ',
          'BR', 'BS', 'BT', 'BV', 'BW', 'BY', 'BZ', 'CA', 'CC', 'CD', 'CF', 'CG', 'CH', 'CI', 'CK',
          'CL', 'CM', 'CN', 'CO', 'CR', 'CU', 'CV', 'CW', 'CX', 'CY', 'CZ', 'DE', 'DJ', 'DK', 'DM',
          'DO', 'DZ', 'EC', 'EE', 'EG', 'EH', 'ER', 'ES', 'ET', 'FI', 'FJ', 'FK', 'FM', 'FO', 'FR',
          'GA', 'GB', 'GD', 'GE', 'GF', 'GG', 'GH', 'GI', 'GL', 'GM', 'GN', 'GP', 'GQ', 'GR', 'GS',
          'GT', 'GU', 'GW', 'GY', 'HK', 'HM', 'HN', 'HR', 'HT', 'HU', 'ID', 'IE', 'IL', 'IM', 'IN',
          'IO', 'IQ', 'IR', 'IS', 'IT', 'JE', 'JM', 'JO', 'JP', 'KE', 'KG', 'KH', 'KI', 'KM', 'KN',
          'KP', 'KR', 'KW', 'KY', 'KZ', 'LA', 'LB', 'LC', 'LI', 'LK', 'LR', 'LS', 'LT', 'LU', 'LV',
          'LY', 'MA', 'MC', 'MD', 'ME', 'MF', 'MG', 'MH', 'MK', 'ML', 'MM', 'MN', 'MO', 'MP', 'MQ',
          'MR', 'MS', 'MT', 'MU', 'MV', 'MW', 'MX', 'MY', 'MZ', 'NA', 'NC', 'NE', 'NF', 'NG', 'NI',
          'NL', 'NO', 'NP', 'NR', 'NU', 'NZ', 'OM', 'PA', 'PE', 'PF', 'PG', 'PH', 'PK', 'PL', 'PM',
          'PN', 'PR', 'PS', 'PT', 'PW', 'PY', 'QA', 'RE', 'RO', 'RS', 'RU', 'RW', 'SA', 'SB', 'SC',
          'SD', 'SE', 'SG', 'SH', 'SI', 'SJ', 'SK', 'SL', 'SM', 'SN', 'SO', 'SR', 'SS', 'ST', 'SV',
          'SX', 'SY', 'SZ', 'TC', 'TD', 'TF', 'TG', 'TH', 'TJ', 'TK', 'TL', 'TM', 'TN', 'TO', 'TR',
          'TT', 'TV', 'TW', 'TZ', 'UA', 'UG', 'UM', 'US', 'UY', 'UZ', 'VA', 'VC', 'VE', 'VG', 'VI',
          'VN', 'VU', 'WF', 'WS', 'XK', 'YE', 'YT', 'ZA', 'ZM', 'ZW'
      ];
    }
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if acceptedRules() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'countryCode', 'updatedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'bio', 'countryCode', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && validCountry(request.resource.data.countryCode)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Public directory. Country codes match the private profile; existing reads remain compatible.
    // Identity is the document UID. Scores and staff roles cannot be self-assigned.
    match /players/{uid} {
      allow read: if true;
      allow create, update: if acceptedRules() && request.auth.uid == uid
        && activePlayer(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'tags', 'countryCode', 'updatedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'bio', 'tags', 'countryCode', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.displayName.matches('.*[^ ].*')
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 300
        && request.resource.data.tags is list
        && request.resource.data.tags.size() >= 1 && request.resource.data.tags.size() <= 3
        && request.resource.data.tags.toSet().size() == request.resource.data.tags.size()
        && request.resource.data.tags.hasOnly(['Player', 'Creator', 'Verifier'])
        && validCountry(request.resource.data.countryCode)
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.displayName == request.resource.data.displayName
        && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.bio == request.resource.data.bio
        && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.countryCode == request.resource.data.countryCode;
      allow create: if staff()
        && request.resource.data.keys().hasOnly(['removed', 'moderatedBy', 'moderatedAt'])
        && validModeration();
      allow update: if staff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'moderatedBy', 'moderatedAt'])
        && validModeration();
      allow delete: if signedIn() && request.auth.uid == uid && activePlayer(uid);
      function validModeration() {
        return request.resource.data.removed is bool
          && request.resource.data.moderatedBy == request.auth.uid
          && request.resource.data.moderatedAt == request.time;
      }
    }
    match /completionSubmissions/{id} {
      allow create: if acceptedRules() && activePlayer(request.auth.uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'player', 'levelId', 'proofUrl', 'notes', 'status', 'submittedAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'player', 'levelId', 'proofUrl', 'notes', 'status', 'submittedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.player == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.displayName
        && request.resource.data.levelId is string
        && exists(/databases/$(database)/documents/levels/$(request.resource.data.levelId))
        && httpsLink(request.resource.data.proofUrl)
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 500
        && request.resource.data.status == 'pending' && request.resource.data.submittedAt == request.time;
      allow get, list: if staff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if staff() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'recordId', 'reviewedAt', 'reviewedBy'])
        && (!('recordId' in request.resource.data) || request.resource.data.recordId is string);
      allow delete: if staff();
    }
    match /submissions/{submissionId} {
      allow create: if acceptedRules() && activePlayer(request.auth.uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'submittedBy', 'levelName', 'levelUrl', 'creator', 'verifier', 'proofUrl', 'notes', 'status', 'submittedAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'submittedBy', 'levelName', 'levelUrl', 'creator', 'verifier', 'proofUrl', 'notes', 'status', 'submittedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.submittedBy is string
        && request.resource.data.submittedBy.size() >= 3
        && request.resource.data.submittedBy.size() <= 24
        && request.resource.data.levelName is string
        && request.resource.data.levelName.size() > 0
        && request.resource.data.levelName.size() <= 80
        && httpsLink(request.resource.data.levelUrl)
        && request.resource.data.creator is string
        && request.resource.data.creator.size() > 0
        && request.resource.data.creator.size() <= 60
        && request.resource.data.verifier is string
        && request.resource.data.verifier.size() > 0
        && request.resource.data.verifier.size() <= 60
        && httpsLink(request.resource.data.proofUrl)
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
      allow get, list: if staff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if staff() && resource.data.status == 'pending'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (!('levelId' in request.resource.data) || request.resource.data.levelId is string)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'levelId', 'reviewedAt', 'reviewedBy']);
      allow delete: if staff();
    }
    // Separate from editable profiles so players cannot erase or forge corrections.
    match /pointAdjustments/{uid} {
      allow read: if true;
      allow create, update: if staff()
        && request.resource.data.keys().hasOnly(['delta', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['delta', 'updatedBy', 'updatedAt'])
        && request.resource.data.delta is number
        && request.resource.data.delta >= -1000000 && request.resource.data.delta <= 1000000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Staff-only coordination for atomic rank shifts and simultaneous inserts.
    match /rankingState/{id} {
      allow read: if staff() && id == 'main';
      allow create, update: if staff() && id == 'main'
        && request.resource.data.keys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /levels/{id} {
      allow read: if true;
      allow create, update: if staff() && validLevel(request.resource.data);
      allow delete: if staff();
    }
    match /records/{id} {
      allow read: if staff() || resource.data.approved == true;
      allow create, update: if staff() && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0 && request.resource.data.player is string
        && request.resource.data.player.size() > 0 && request.resource.data.levelId is string
        && request.resource.data.progress == 100 && request.resource.data.approved is bool
        && exists(/databases/$(database)/documents/levels/$(request.resource.data.levelId));
      allow delete: if staff();
    }
  }
}

